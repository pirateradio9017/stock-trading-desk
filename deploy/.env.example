# Stock Trading Desk v2.0 — VPS 常驻生产环境变量模板
# 复制到 /opt/stock-trading-desk/.env 并执行 chmod 600 /opt/stock-trading-desk/.env

# === 大模型研判密钥（至少填 DEEPSEEK_API_KEY；建议双配实现自动回退） ===
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
DESK_LLM_PROVIDER=auto
DEEPSEEK_MODEL=deepseek-flash

# === VPS 常驻服务与内置调度器 ===
DESK_HOST=127.0.0.1
DESK_PORT=8787
DESK_DATA_DIR=/opt/stock-trading-desk/data
DESK_LOG_LEVEL=INFO
DESK_ENABLE_SCHEDULER=1
DESK_SCHEDULER_USE_LLM=1
DESK_SCHEDULER_PUBLISH_KV=0

# === 高频刷新节奏（纯内存零写限额，可按需微调） ===
# 交易时段行情刷新间隔（秒）/ 闲时刷新间隔（秒）
DESK_LIVE_ACTIVE_SEC=10
DESK_LIVE_IDLE_SEC=90
DESK_LIVE_PERSIST_SEC=60
# 快讯刷新间隔（秒）
DESK_NEWS_ACTIVE_SEC=60
DESK_NEWS_IDLE_SEC=180
# 深度研判周期（分钟）：美股活跃时段 / 工作日闲时 / 周末休市
DESK_RESEARCH_ACTIVE_MIN=20
DESK_RESEARCH_WEEKDAY_IDLE_MIN=60
DESK_RESEARCH_IDLE_MIN=120

# === 安全凭证 ===
# 手动强刷研判口令（POST /api/admin/run-pipeline 需携带 X-Admin-Token）
DESK_ADMIN_TOKEN=
# 可选：若通过 Cloudflare Worker 透传访问，设一个随机密钥防外网直扫 IP
DESK_ORIGIN_SECRET=
